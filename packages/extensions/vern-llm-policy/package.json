{
  "name": "vern-llm-policy",
  "version": "0.0.0",
  "description": "Rules for which providers and models a vern-llm call may use, and whether it may run at all",
  "keywords": [
    "vern-llm",
    "policy",
    "governance",
    "compliance",
    "data-residency",
    "llm"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "sideEffects": false,
  "engines": {
    "node": ">=22.22.0"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:unit:coverage": "vitest run --project unit --coverage",
    "test:int": "vitest run --project integration",
    "test:int:coverage": "vitest run --project integration --coverage",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "smoke-test": "node scripts/smoke-test.ts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "prepublishOnly": "pnpm run typecheck && pnpm run build && pnpm run smoke-test",
    "bench:check": "node scripts/bench-check.ts",
    "bench:update": "node scripts/bench-check.ts --update",
    "bench": "vitest bench --run"
  },
  "peerDependencies": {
    "vern-llm": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^4.1.12",
    "publint": "^0.3.24",
    "tsdown": "^0.23.4",
    "typescript": "^5.9.3",
    "unplugin-unused": "^0.6.0",
    "vern-llm": "workspace:^",
    "vern-llm-logger": "workspace:^",
    "vern-llm-router": "workspace:^",
    "vern-llm-usage": "workspace:^",
    "vitest": "^4.1.12"
  },
  "license": "MIT",
  "packageManager": "pnpm@11.27.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LakBud/vernLLM.git",
    "directory": "packages/extensions/vern-llm-policy"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
