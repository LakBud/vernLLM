{
  "name": "vern-llm",
  "version": "3.0.0",
  "description": "The LLM call framework. Resilience, observability, and control for every call. Retry budgets, timeouts, provider fallback, rate limiting, circuit breaking and more, dependency-light and typed from the start.",
  "keywords": [
    "llm",
    "ai",
    "openai",
    "anthropic",
    "gemini",
    "ai-sdk",
    "llm-client",
    "retry",
    "timeout",
    "caching",
    "circuit-breaker",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./adapters": {
      "import": {
        "types": "./dist/adapters/index.d.mts",
        "default": "./dist/adapters/index.mjs"
      },
      "require": {
        "types": "./dist/adapters/index.d.cts",
        "default": "./dist/adapters/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "smoke-test": "node scripts/smoke-test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:unit:coverage": "vitest run --project unit --coverage",
    "test:int": "vitest run --project integration",
    "test:int:coverage": "vitest run --project integration --coverage",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "prepublishOnly": "pnpm run typecheck && pnpm run build && pnpm run size && pnpm run smoke-test",
    "bench:check": "node scripts/bench-check.ts",
    "bench:update": "node scripts/bench-check.ts --update",
    "bench": "vitest bench --run",
    "size": "size-limit"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@changesets/cli": "^3.0.3",
    "@google/genai": "^2.32.0",
    "@size-limit/file": "^14.3.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "groq-sdk": "^1.6.0",
    "openai": "^7.45.1",
    "publint": "^0.3.25",
    "size-limit": "^14.3.0",
    "tsdown": "^0.23.4",
    "typescript": "^7.0.2",
    "unplugin-unused": "^0.6.0",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  },
  "packageManager": "pnpm@11.27.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LakBud/vernLLM.git",
    "directory": "packages/vern-llm"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "size-limit": [
    {
      "path": "dist/index.mjs",
      "limit": "120 KB"
    },
    {
      "path": "dist/index.cjs",
      "limit": "120 KB"
    },
    {
      "path": "dist/adapters/index.mjs",
      "limit": "12 KB"
    },
    {
      "path": "dist/adapters/index.cjs",
      "limit": "12 KB"
    }
  ]
}
