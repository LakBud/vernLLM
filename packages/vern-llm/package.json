{
  "name": "vern-llm",
  "version": "2.7.0",
  "description": "The LLM call framework. Resilience, observability, and control for every call. Retries, timeouts, provider fallback, rate limiting, circuit breaking and more, dependency-light and typed from the start.",
  "keywords": [
    "llm",
    "ai",
    "openai",
    "anthropic",
    "gemini",
    "bedrock",
    "ai-sdk",
    "llm-client",
    "retry",
    "timeout",
    "caching",
    "circuit-breaker",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "smoke-test": "node scripts/smoke-test.mts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:unit:coverage": "vitest run --project unit --coverage",
    "test:int": "vitest run --project integration",
    "test:int:coverage": "vitest run --project integration --coverage",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm run build && changeset publish",
    "prepublishOnly": "pnpm run typecheck && pnpm run build && pnpm run size && pnpm run smoke-test",
    "size": "size-limit"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1121.0",
    "@changesets/cli": "^3.0.1",
    "@google/genai": "^2.19.0",
    "@size-limit/file": "^13.0.3",
    "@smithy/eventstream-serde-node": "^4.5.2",
    "@smithy/node-http-handler": "^4.11.3",
    "@smithy/util-utf8": "^4.5.2",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "groq-sdk": "^1.6.0",
    "openai": "^7.4.0",
    "publint": "^0.3.24",
    "size-limit": "^13.0.3",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "unplugin-unused": "^0.5.7",
    "vitest": "^4.1.11",
    "zod": "^4.5.4"
  },
  "packageManager": "pnpm@11.24.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LakBud/vernLLM.git",
    "directory": "packages/vern-llm"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "size-limit": [
    {
      "path": "dist/index.mjs",
      "limit": "120 KB"
    },
    {
      "path": "dist/index.cjs",
      "limit": "120 KB"
    }
  ]
}
