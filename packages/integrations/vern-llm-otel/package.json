{
  "name": "vern-llm-otel",
  "version": "0.2.0",
  "description": "OpenTelemetry traces and metrics for vern-llm, following the GenAI semantic conventions",
  "keywords": [
    "vern-llm",
    "opentelemetry",
    "otel",
    "tracing",
    "metrics",
    "observability",
    "genai",
    "llm"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "sideEffects": false,
  "engines": {
    "node": ">=22.22.0"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "smoke-test": "node scripts/smoke-test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:unit:coverage": "vitest run --project unit --coverage",
    "test:int": "vitest run --project integration",
    "test:int:coverage": "vitest run --project integration --coverage",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "prepublishOnly": "pnpm run typecheck && pnpm run build && pnpm run size && pnpm run smoke-test",
    "bench:check": "node scripts/bench-check.ts",
    "bench:update": "node scripts/bench-check.ts --update",
    "bench": "vitest bench --run",
    "size": "size-limit"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.1",
    "vern-llm": "workspace:^"
  },
  "devDependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1136.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.11.0",
    "@opentelemetry/sdk-metrics": "^3.0.0",
    "@opentelemetry/sdk-trace": "^2.11.0",
    "@size-limit/esbuild": "13.1.1",
    "@size-limit/file": "13.1.1",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^4.1.11",
    "publint": "^0.3.24",
    "size-limit": "13.1.1",
    "tsdown": "^0.23.1",
    "typescript": "^5.9.3",
    "unplugin-unused": "^0.6.0",
    "vern-llm": "workspace:^",
    "vern-llm-bedrock": "workspace:^",
    "vitest": "^4.1.11"
  },
  "license": "MIT",
  "packageManager": "pnpm@11.27.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LakBud/vernLLM.git",
    "directory": "packages/integrations/vern-llm-otel"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "size-limit": [
    {
      "path": "dist/index.mjs",
      "limit": "9.2 KB",
      "ignore": [
        "vern-llm",
        "@opentelemetry/api"
      ]
    },
    {
      "path": "dist/index.cjs",
      "limit": "9.3 KB",
      "ignore": [
        "vern-llm",
        "@opentelemetry/api"
      ]
    }
  ]
}
