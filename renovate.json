{
  "extends": ["config:recommended", "group:allNonMajor"],

  "dependencyDashboard": true,
  "dependencyDashboardApproval": false,

  "minimumReleaseAge": "1 day",

  "rangeStrategy": "bump",

  "prCreation": "status-success",

  "timezone": "Europe/Oslo",

  "schedule": ["every weekend"],

  "labels": ["dependencies"],

  "commitMessagePrefix": "chore(deps):",

  "prConcurrentLimit": 3,

  "platformAutomerge": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",

  "packageRules": [
    {
      "description": "Group all docs app updates into one PR",
      "groupName": "docs app dependencies",
      "matchFileNames": ["apps/docs/**"]
    },

    {
      "description": "Group GitHub Actions updates into one PR",
      "groupName": "github actions",
      "matchManagers": ["github-actions"]
    },

    {
      "description": "Group TypeScript ecosystem updates",
      "groupName": "typescript tooling",
      "matchPackageNames": ["typescript", "tsdown", "vitest", "@vitest/**"]
    },

    {
      "description": "Group Redis clients into their own PR",
      "groupName": "redis",
      "matchPackageNames": ["ioredis", "redis"]
    },

    {
      "description": "Group OpenTelemetry into its own PR",
      "groupName": "opentelemetry",
      "matchPackageNames": ["@opentelemetry/**"]
    },

    {
      "description": "Group Bedrock provider (SDK + smithy internals) into its own PR",
      "groupName": "aws bedrock provider",
      "matchPackageNames": [
        "@aws-sdk/client-bedrock-runtime",
        "@smithy/eventstream-serde-node",
        "@smithy/node-http-handler",
        "@smithy/util-utf8"
      ]
    },

    {
      "description": "Keep provider SDKs ungrouped so each gets its own PR",
      "matchPackageNames": ["@anthropic-ai/sdk", "@google/genai", "groq-sdk", "openai"],
      "groupName": null
    },

    {
      "description": "Do not auto merge risky dependencies",
      "matchPackageNames": ["openai", "typescript", "tsdown", "vitest"],
      "automerge": false
    },

    {
      "description": "Auto merge safe patches",
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },

    {
      "description": "Require manual dashboard approval and no automerge for majors",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "dependencyDashboardApproval": true
    },

    {
      "description": "Hold Node.js runtime separate, no automerge until LTS flips",
      "groupName": "node runtime",
      "matchDatasources": ["node-version"],
      "automerge": false,
      "dependencyDashboardApproval": true
    },

    {
      "description": "Hold @types/node separate, no automerge until LTS flips",
      "groupName": "node",
      "matchPackageNames": ["@types/node"],
      "automerge": false,
      "dependencyDashboardApproval": true
    }
  ],

  "ignorePresets": ["workarounds:javaLTSVersions"],

  "postUpdateOptions": ["pnpmDedupe"]
}
